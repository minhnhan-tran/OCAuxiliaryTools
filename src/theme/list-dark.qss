QListWidget::item:hover{background-color:rgba(190,190,190,50);margin:1px,1px,1px,1px;border-radius:6;color:#e6e6e6}
QListWidget::item:selected{background:rgba(190,190,190,50);border:0px blue;margin:1px,1px,1px,1px;border-radius:6;color:#07a4f6}
QListWidget::item{background-color:none;margin:1px,1px,1px,1px;color:#bfbfbf}
